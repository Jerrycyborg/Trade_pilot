ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
BROKER=etoro
ETORO_API_KEY=your_public_api_key
ETORO_USER_KEY=your_user_key
ETORO_DEMO=true
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
WEBHOOK_URL=
WORKER_ENABLED=false
WORKER_INTERVAL_MINUTES=15
ORCHESTRATOR_INTERVAL_MINUTES=5
SENTIMENT_WEIGHT=0.3
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_HOLD_HOURS=48
STRATEGY_WATCHLIST=AAPL,MSFT,GOOGL,BTC/USD,ETH/USD
AUDIT_LOGGER_URL=http://localhost:8006
APPROVAL_GATEWAY_URL=http://localhost:8010
NOTIFICATION_SERVICE_URL=http://localhost:8009
SENTIMENT_SERVICE_URL=http://localhost:8008
INTERNAL_API_KEY=change-me-internal-secret
ADMIN_API_KEY=change-me-admin-secret

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Provider: leave blank to use Alpaca when ALPACA_API_KEY + ALPACA_SECRET_KEY
# are set and fall back to Yahoo otherwise; set to "yahoo" to force Yahoo.
#   alpaca — real-time, streaming, needs a (free) account
#   yahoo  — no API key, but intraday data is delayed ~15 min and cannot stream
MARKET_DATA_PROVIDER=yahoo

# ---------------------------------------------------------------------------
# Intraday trading
# ---------------------------------------------------------------------------
# Set MARKET_DATA_TIMEFRAME=intraday to trade on intraday bars. This works with
# either provider; Alpaca gives real-time bars, Yahoo delayed ones.
# Verify before trading:  uv run python scripts/verify_intraday.py
# MARKET_DATA_TIMEFRAME=intraday
# INTRADAY_MINUTES=15          # bar size; Yahoo serves 1,2,5,15,30,60,90
# INTRADAY_LOOKBACK_DAYS=5     # history for indicators (Yahoo caps 1m at 7d)

# Real-time bar stream over websocket (Alpaca only). Without it prices are
# polled, which is slower and costs an HTTP call per lookup.
# STREAMING_ENABLED=true
# STREAM_SYMBOLS=AAPL,MSFT     # defaults to the policy allowlist
# STREAM_SYMBOL_LIMIT=30       # Alpaca's free IEX feed caps subscriptions
# ALPACA_FEED=iex              # "sip" on a paid data plan

# A price older than this is treated as unusable for a trading decision.
# MAX_PRICE_AGE_SECONDS=120

# Trading loop cadence. Under intraday the stop-loss and take-profit checks
# default to every 60s; they default to 300s on daily bars.
# ORCHESTRATOR_INTERVAL_SECONDS=60
# STOP_LOSS_CHECK_INTERVAL_MINUTES=1
# TAKE_PROFIT_CHECK_INTERVAL_MINUTES=1

# ---------------------------------------------------------------------------
# Paper broker (BROKER=paper) — simulated fills priced from live market data
# ---------------------------------------------------------------------------
PAPER_STARTING_CASH=100000
PAPER_SLIPPAGE_BPS=2
PAPER_STATE_PATH=./paper-broker-state.json

# ---------------------------------------------------------------------------
# Pattern day trader (PDT) guard  — US FINRA rule
# ---------------------------------------------------------------------------
# Four or more day trades (open and close the same symbol in one session) within
# five business days, with account equity under $25,000, gets an account
# designated a pattern day trader and restricted. The guard blocks new ENTRIES
# when the budget is spent; it never blocks an exit, because holding a losing
# position past its stop to dodge a compliance flag is the worse trade.
#
# This is a US margin-account rule. Cash accounts face settlement rules instead
# and non-US brokers have their own regimes — confirm with YOUR broker, then set
# PDT_ENABLED=false if it does not apply. Being flagged is disruptive to undo.
PDT_ENABLED=true
PDT_EQUITY_THRESHOLD_USD=25000
PDT_MAX_DAY_TRADES=3         # the 4th is what triggers designation; 2 for margin
PDT_STATE_PATH=./day-trade-state.json

# ---------------------------------------------------------------------------
# Phase 0 — point-in-time archive and reconciliation
# ---------------------------------------------------------------------------
# Every bar and price the system acts on, plus every decision and the inputs
# behind it, written to one SQLite file. This is the raw material for honest
# research later: without it you cannot reconstruct what was knowable at the
# time, and every backtest built on hindsight is contaminated.
JOURNAL_ENABLED=true
JOURNAL_PATH=./journal.db

# Ledger-vs-broker reconciliation. The broker is the source of truth;
# portfolio-service derives holdings from our own fills and is a cache.
# A divergence must persist across this many consecutive checks before new
# entries are blocked — a fill in flight legitimately shows at the broker first.
# Exits are never blocked.
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_BREAKS_BEFORE_HALT=2

# ---------------------------------------------------------------------------
# Execution quality — how orders are priced and how large they are allowed to be
# ---------------------------------------------------------------------------
# Marketable limit orders instead of market orders. A market order accepts
# whatever the book offers; on a thin symbol or during a spike that is not the
# price the strategy assumed. A marketable limit is priced through the touch so
# it fills immediately in normal conditions, but refuses a fill beyond the
# tolerance below. Paired with immediate-or-cancel it fills now or not at all,
# leaving nothing working that would need managing.
#
# The trade-off is direct: a wider tolerance fills more often and pays more; a
# narrower one protects the price and misses more. Both costs are measured —
# see GET /v1/execution/quality — so tune this from your own fill data rather
# than from a guess.
USE_LIMIT_ORDERS=true
LIMIT_TOLERANCE_BPS=10

# Cap an order at this share of the symbol's average daily volume. Being a
# large fraction of what trades moves the price against you, so the cost of the
# order becomes a function of its own size. 1% is conservative; mega-caps will
# never approach it, thin small caps will be trimmed hard, and a symbol too
# thin to take even one share is skipped rather than forced. Set to 0 to
# disable the cap entirely.
MAX_ADV_PARTICIPATION=0.01

# Signal quality gates
SENTIMENT_BLOCK_THRESHOLD=-0.3
EARNINGS_BLACKOUT_DAYS=2

# Trader risk controls
MONTHLY_LOSS_LIMIT_USD=10.0
MONTHLY_PROFIT_TARGET_USD=20.0
TAKE_PROFIT_TARGET_USD=20.0
WALLET_SIZE_USD=50.0
