ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
BROKER=etoro
ETORO_API_KEY=your_public_api_key
ETORO_USER_KEY=your_user_key
ETORO_DEMO=true
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
WEBHOOK_URL=
WORKER_ENABLED=false
WORKER_INTERVAL_MINUTES=15
ORCHESTRATOR_INTERVAL_MINUTES=5
SENTIMENT_WEIGHT=0.3
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
MAX_HOLD_HOURS=48
STRATEGY_WATCHLIST=AAPL,MSFT,GOOGL,BTC/USD,ETH/USD
AUDIT_LOGGER_URL=http://localhost:8006
APPROVAL_GATEWAY_URL=http://localhost:8010
NOTIFICATION_SERVICE_URL=http://localhost:8009
SENTIMENT_SERVICE_URL=http://localhost:8008
INTERNAL_API_KEY=change-me-internal-secret
ADMIN_API_KEY=change-me-admin-secret

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Provider: leave blank to use Alpaca when ALPACA_API_KEY + ALPACA_SECRET_KEY
# are set and fall back to Yahoo otherwise; set to "yahoo" to force Yahoo.
#   alpaca — real-time, streaming, needs a (free) account
#   yahoo  — no API key, but intraday data is delayed ~15 min and cannot stream
MARKET_DATA_PROVIDER=yahoo

# ---------------------------------------------------------------------------
# Intraday trading
# ---------------------------------------------------------------------------
# Set MARKET_DATA_TIMEFRAME=intraday to trade on intraday bars. This works with
# either provider; Alpaca gives real-time bars, Yahoo delayed ones.
# Verify before trading:  uv run python scripts/verify_intraday.py
# MARKET_DATA_TIMEFRAME=intraday
# INTRADAY_MINUTES=15          # bar size; Yahoo serves 1,2,5,15,30,60,90
# INTRADAY_LOOKBACK_DAYS=5     # history for indicators (Yahoo caps 1m at 7d)

# Real-time bar stream over websocket (Alpaca only). Without it prices are
# polled, which is slower and costs an HTTP call per lookup.
# STREAMING_ENABLED=true
# STREAM_SYMBOLS=AAPL,MSFT     # defaults to the policy allowlist
# STREAM_SYMBOL_LIMIT=30       # Alpaca's free IEX feed caps subscriptions
# ALPACA_FEED=iex              # "sip" on a paid data plan

# A price older than this is treated as unusable for a trading decision.
# MAX_PRICE_AGE_SECONDS=120

# Trading loop cadence. Under intraday the stop-loss and take-profit checks
# default to every 60s; they default to 300s on daily bars.
# ORCHESTRATOR_INTERVAL_SECONDS=60
# STOP_LOSS_CHECK_INTERVAL_MINUTES=1
# TAKE_PROFIT_CHECK_INTERVAL_MINUTES=1

# ---------------------------------------------------------------------------
# Paper broker (BROKER=paper) — simulated fills priced from live market data
# ---------------------------------------------------------------------------
PAPER_STARTING_CASH=100000
PAPER_SLIPPAGE_BPS=2
PAPER_STATE_PATH=./paper-broker-state.json

# Signal quality gates
SENTIMENT_BLOCK_THRESHOLD=-0.3
EARNINGS_BLACKOUT_DAYS=2

# Trader risk controls
MONTHLY_LOSS_LIMIT_USD=10.0
MONTHLY_PROFIT_TARGET_USD=20.0
TAKE_PROFIT_TARGET_USD=20.0
WALLET_SIZE_USD=50.0
